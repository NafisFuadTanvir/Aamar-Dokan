# ─────────────────────────────────────────────────────────────────────────────
# Bangladesh E-Commerce Store — Environment Variables
# Copy this file to .env and fill in the values for your environment.
# Secrets MUST NEVER be committed to Git or exposed via NEXT_PUBLIC_* variables.
# ─────────────────────────────────────────────────────────────────────────────

# ── App Configuration ────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STORE_NAME="Amar Dokan"

# ── Authentication (NextAuth / Auth.js v5) ──────────────────────────────────
# Generate a secure 32+ character random string: openssl rand -base64 32
AUTH_SECRET=changeme_must_be_at_least_32_characters_long_for_security

# ── Cron Security ────────────────────────────────────────────────────────────
# Used in Authorization: Bearer <CRON_SECRET> header to protect outbox/worker endpoints
# Generate with: openssl rand -base64 32
CRON_SECRET=super_secret_cron_token_min_16_chars

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Connection string for PostgreSQL instance (Neon, Supabase, Railway, AWS RDS, or local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecommerce?schema=public"

# ── Payment Gateway (SSLCommerz) ─────────────────────────────────────────────
# Required for real payment processing. Leave empty for NOT_CONFIGURED status.
# In development, MOCK adapter can be enabled if explicitly tested.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

# ── Order Notifications (Telegram Bot API) ───────────────────────────────────
# Replaces WhatsApp per store owner requirement.
# Messages sent only after backend independently verifies successful payment.
# Leave empty for NOT_CONFIGURED status (never silently drops orders).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Email Service (Optional SMTP) ────────────────────────────────────────────
# Optional: Nodemailer SMTP. If absent, customer password resets are handled via
# secure admin-assisted reset links in the admin dashboard.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM="Amar Dokan <noreply@example.com>"
